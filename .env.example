# Copy to .env (git-ignored) and fill in. Both are free tiers.
# Groq: https://console.groq.com/keys    Gemini: https://aistudio.google.com/apikey
# With no keys the server still runs: suspects fall back to scripted lines.
GROQ_API_KEY=
GEMINI_API_KEY=
# Sarvam speech-to-text for the mic (optional; the browser falls back to its own recognition without it)
# https://dashboard.sarvam.ai
SARVAM_API_KEY=
